{
  "name": "murama-school-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "test": "tsx --test src/config/sql-compat.test.ts src/middleware/rate-limit.test.ts",
    "migrate:mysql-to-supabase": "tsx src/scripts/migrate-mysql-to-supabase.ts"
  },
  "dependencies": {
    "bcryptjs": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "morgan": "latest",
    "mysql2": "latest",
    "postgres": "3.4.9",
    "serverless-http": "4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/morgan": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
