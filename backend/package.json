{
  "name": "murama-school-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "test": "tsx --test src/config/sql-compat.test.ts src/middleware/rate-limit.test.ts src/middleware/auth.test.ts src/services/portal-access.test.ts src/services/student-parent-portal.service.test.ts src/services/invitation-policy.test.ts src/services/visit-request-policy.test.ts src/services/media-upload-policy.test.ts src/services/production-readiness.test.ts",
    "migrate:mysql-to-supabase": "tsx src/scripts/migrate-mysql-to-supabase.ts",
    "smoke:e2e": "tsx src/scripts/e2e-smoke.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.12.1",
    "mysql2": "3.24.5",
    "postgres": "3.4.9",
    "serverless-http": "4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "3.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
