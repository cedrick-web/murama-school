PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Required application database: Supabase PostgreSQL session-pooler connection.
# Keep this backend-only. Use the connection string shown in Supabase Dashboard > Connect.
SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:[DATABASE_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://uslimteaskxrpqlauygj.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Authentication secret: generate a private random value of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional legacy XAMPP/MySQL source, used only by the one-time data migration command.
# Do not point the live application API at MySQL.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=murama_school
MYSQL_USER=root
MYSQL_PASSWORD=
