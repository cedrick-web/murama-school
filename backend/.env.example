PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Required application database: Supabase PostgreSQL connection URI.
# Local persistent backend: use the Supabase Session pooler URI.
# Netlify/serverless functions: use the Transaction pooler URI (port 6543).
# Keep this backend-only. Never expose it through a VITE_ variable.
SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:[DATABASE_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://ilmvmqxmasgasrtokjmz.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_cqibvNHUsa4-UFSswZSfkg_4QDNf_G4

# Required only for signed school-media uploads and server-side storage administration.
# Use the Supabase service_role secret from the project's API keys page. SERVER ONLY: never add a VITE_ prefix or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Authentication secret: generate a private random value of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional legacy XAMPP/MySQL source, used only by the one-time data migration command.
# Do not point the live application API at MySQL.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=murama_school
MYSQL_USER=root
MYSQL_PASSWORD=
