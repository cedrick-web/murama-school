PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL connection will be added in the database stage.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=murama_school
DB_USER=root
DB_PASSWORD=

# Authentication secret: replace locally, never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional Supabase Google authentication. Use only the publishable/anon key here.
# Never expose a service-role or secret key to the frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
